# Kelsa service account (read-only use). Server-side only; never exposed to the browser.
KELSA_USER_EMAIL=
KELSA_USER_TOKEN=
KELSA_ORIGIN=https://kelsa.io

# Optional
PORT=3471
# How long live data is cached on the server (ms, 30s–60min). Default 5 minutes.
DATA_TTL_MS=300000
# 1 = always serve the built-in sample data (it is used automatically in development when no credentials are set).
KELSA_SAMPLE_DATA=
